{
  "name": "pi-strip-images",
  "version": "0.1.0",
  "description": "pi extension: strip image blocks from model context so image-bearing conversations keep working on text-only models",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "repository": "github:philipp-mlr/pi-strip-images",
